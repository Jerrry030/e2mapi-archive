#!/usr/bin/env sh
if command -v make >/dev/null 2>&1; then
  make fmt-check lint
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/e2m.ps1 fmt-check && \
    pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/e2m.ps1 lint
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2m.ps1 fmt-check && \
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2m.ps1 lint
else
  echo "Neither make nor PowerShell is available; cannot run pre-commit checks."
  exit 1
fi
