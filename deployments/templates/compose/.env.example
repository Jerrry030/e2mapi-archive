# From the repository root, copy this file to
# deployments/templates/compose/.env and fill in real values.
# docker compose --env-file deployments/templates/compose/.env -f deployments/templates/compose/e2m-core-prod.compose.yml up -d --build

# --- Database ---
POSTGRES_USER=e2m
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=e2m

# --- Upstream intelligence cursor signing ---
# Shared by all Core replicas. Format: kid=64hex[,previous-kid=64hex].
# Generate each value with: openssl rand -hex 32
E2M_UPSTREAM_INTELLIGENCE_CURSOR_ACTIVE_KID=2026-07
E2M_UPSTREAM_INTELLIGENCE_CURSOR_KEYS=2026-07=REPLACE_WITH_64_HEX_CHARS # gitleaks:allow

# --- Upstream recommendation and guarded rollout ---
# Recommendation/shadow/dry-run APIs are experimental and closed by default.
E2M_UPSTREAM_RECOMMENDATIONS=false
# Only explicit true permits forward rollout start/advance. Disabling it does
# not disable rollout list/get/rollback or the rollback recovery workers.
E2M_UPSTREAM_OPTIMIZATION_AUTO_APPLY=false
# Safe defaults are shown explicitly for operational review. Keep these values
# in production unless controlled evidence justifies different tuning.
E2M_RECOMMENDATION_ROLLOUT_OBSERVATION=5m
E2M_RECOMMENDATION_ROLLOUT_WORKER_INTERVAL=1s
E2M_RECOMMENDATION_ROLLOUT_WORKER_LEASE=2m
E2M_RECOMMENDATION_ROLLOUT_RUNNER_INTERVAL=1s

# --- Console: first admin (created once on an empty database) ---
E2M_ADMIN_EMAIL=admin@example.com
E2M_ADMIN_PASSWORD=change-me-min-8-chars

# --- Public client self-registration (closed by default) ---
# When enabled, public /register creates one client-role account.
# These are first-boot defaults; admins can override them later in
# Console -> System Settings without changing compose env.
E2M_AUTH_REGISTRATION_ENABLED=false
# Comma-separated allow-list. Empty means any email suffix is allowed.
# Supports @example.com, example.com, and *.edu.cn.
E2M_AUTH_REGISTRATION_EMAIL_SUFFIXES=
# Turnstile is optional. Only set enabled=true when both site and secret keys exist.
E2M_AUTH_TURNSTILE_ENABLED=false
E2M_AUTH_TURNSTILE_SITE_KEY=
E2M_AUTH_TURNSTILE_SECRET_KEY=

# --- Incomplete commercial modules (closed by default) ---
# Keep these false until unified wallet, trusted metering, and settlement
# controls are production-ready. The Console has matching VITE_* build flags.
E2M_ENABLE_BILLING=false
# Payments controls the whole top-up loop: admin payment config/providers/orders,
# owner recharge orders, provider webhooks, and the order expiry sweeper.
E2M_ENABLE_PAYMENTS=false
# Sweep interval for timed-out recharge orders (query upstream, recover missed
# notifications, close and expire unpaid sessions). Default 60s.
E2M_PAYMENT_EXPIRY_INTERVAL=60s
E2M_ENABLE_SUPPLY=false
# Retired percentage-routing experiment. The active E2M-native platform data
# plane is served by Core itself and does not require this switch.
E2M_ENABLE_HYBRID_SUPPLY=false
E2M_HYBRID_ROUTING_WORKER_INTERVAL=1s
E2M_HYBRID_ROUTING_WORKER_LEASE=2m
# Core serves the platform-compatible endpoint at E2M_CORE_PUBLIC_URL/v1.
E2M_SUPPLY_CURRENCY=CNY
# Commerce runtime settings (USD->CNY rate, wallet alert threshold) live in
# the unified settings module: these env values only SEED THE FIRST BOOT and
# are ignored afterwards - edit them in the console under 系统设置 → 商务定价.
# The embedded price table is a bootstrap snapshot only; mount a reviewed
# current table via E2M_PRICE_TABLE_PATH for production pricing.
E2M_USD_TO_CNY_RATE=
E2M_PRICE_TABLE_PATH=
# Seed-only, see above (yuan; empty = alerts disabled).
E2M_PLATFORM_BALANCE_THRESHOLD=
# Require an unused invitation redeem code at public registration.
E2M_AUTH_INVITATION_REQUIRED=false
# Legacy emergency compatibility only. Never enable in production: plaintext
# owner Key export can bypass Connector metering and future balance controls.
E2M_OWNER_KEY_REVEAL=false

# --- Connector enrollment ---
# Public URL used by Core when generating per-instance Connector installs.
E2M_CORE_PUBLIC_URL=https://core.example.com
# The optional Connector profile represents exactly one gateway instance.
# Generate its one-time enrollment in the console, save the token in this file,
# and use a distinct Connector ID, instance ID, UI port, file, and data volume
# for every additional instance.
E2M_CONNECTOR_CORE_URL=https://core.example.com
E2M_CONNECTOR_ID=replace-with-connector-id
E2M_INSTANCE_ID=replace-with-instance-id
E2M_CONNECTOR_ENROLLMENT_FILE=./secrets/e2m-connector-enrollment-token
E2M_CONNECTOR_UI_PORT=18081

# --- Vault master key: 64 hex chars. Generate with:
#     openssl rand -hex 32
# This Core vault stores notification, upstream/supply, proxy, virtual-key, and
# enabled payment-provider credentials. Gateway management credentials stay in
# the Connector's local data volume. Supply Gateway mounts this file read-only.
E2M_VAULT_KEY=REPLACE_WITH_64_HEX_CHARS_FROM_OPENSSL_RAND_HEX_32

# --- Public port for the console + API ---
E2M_PORT=8080

# --- Balance alerting (0 disables). Set to your low-balance water mark. ---
E2M_BALANCE_THRESHOLD=0

# --- Notifications (optional) ---
E2M_FEISHU_WEBHOOK=
E2M_FEISHU_SECRET=
E2M_QQ_ONEBOT_URL=
E2M_QQ_TOKEN=
E2M_QQ_GROUP_ID=

# --- Billing (integer cents; used only when E2M_ENABLE_BILLING=true) ---
E2M_BILL_INSTANCE_CENTS=19900
E2M_BILL_DISPOSITION_CENTS=100
E2M_BILL_CURRENCY=CNY
